{
  "manifest_version": 3,
  "default_locale": "ja",
  "name": "読むプ ： ハイライト・タイマーで集中Web/PDF読書",
  "version": "3.15.0",
  "description": "ハイライトとタイマーで、Web/PDF読書の読みやすさ・集中を支援します。",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["constants.js", "ui-strings.js", "reading-settings.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "ハイライト＆タイマーで読書をヘルプ"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "images/*",
        "icon48.png",
        "vendor/*",
        "vendor/cmaps/*",
        "vendor/standard_fonts/*",
        "pdf/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
